{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2024", "ESNext.Promise"],
    "module": "ESNext",
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "stripInternal": true,
    "outDir": "dist",
    "allowJs": true
  }
}
